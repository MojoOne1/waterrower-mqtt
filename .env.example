# Copy to .env next to docker-compose.yml (the one at the repo root).

# The arena's first login. Only read while no `admin` athlete exists.
ARENA_ADMIN_PASSWORD=
# Set to 1 with a new password above to reset a lost admin password on the
# next start, then put it back to 0.
ARENA_ADMIN_RESET=0
# 0 while you reach the arena over plain http, 1 once the tunnel is in front.
ARENA_SECURE_COOKIES=0

# The broker the tracker signs in to. With --profile broker this is the
# Mosquitto in this stack; otherwise point MQTT_HOST at your own.
MQTT_PASSWORD=
# MQTT_HOST=mosquitto
# MQTT_USERNAME=waterrower

# Only needed with --profile tunnel.
TUNNEL_TOKEN=
