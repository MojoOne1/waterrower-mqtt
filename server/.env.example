# Copy to .env next to docker-compose.yml and fill in.

# Required: the first login, used only while no `admin` athlete exists.
ARENA_ADMIN_PASSWORD=

# Only needed for `docker compose --profile tunnel up -d`.
TUNNEL_TOKEN=

# 0 while testing over plain http://<vm>:8090, 1 behind Cloudflare.
ARENA_SECURE_COOKIES=0

# Set to 1 with a new ARENA_ADMIN_PASSWORD above to reset a lost admin
# password on the next start. Put it back to 0 once you are in.
ARENA_ADMIN_RESET=0
