# Copy to .env next to the compose file you are using.

# --- Row together (docker-compose.yml at the repository root) -------------
# The arena's first login. Only read while no `admin` athlete exists.
ARENA_ADMIN_PASSWORD=
# Set to 1 with a new password above to reset a lost admin password on the
# next start, then put it back to 0.
ARENA_ADMIN_RESET=0
# 1 behind the tunnel; 0 only while you reach the arena over plain http.
ARENA_SECURE_COOKIES=1
# From Cloudflare Zero Trust -> Networks -> Tunnels.
TUNNEL_TOKEN=

# --- Both files -----------------------------------------------------------
# The broker the tracker signs in to. Leave MQTT_HOST at `mosquitto` if you
# uncommented the broker block in the compose file.
MQTT_HOST=mosquitto
MQTT_USERNAME=waterrower
MQTT_PASSWORD=
